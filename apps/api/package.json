{
  "name": "@nimanto/api",
  "version": "0.10.1-dev.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --conditions=development --import tsx --watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --coverage.enabled=false --testTimeout=30000 --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@nimanto/database": "workspace:*",
    "@nimanto/documents": "workspace:*",
    "@nimanto/domain": "workspace:*",
    "@nimanto/parsers": "workspace:*",
    "@nimanto/providers": "workspace:*",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
