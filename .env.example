# Local web and API. Defaults already work for `pnpm dev`.
NIMANTO_API_HOST=127.0.0.1
NIMANTO_API_PORT=4310
NIMANTO_WEB_ORIGIN=http://127.0.0.1:4300
NEXT_PUBLIC_NIMANTO_API_ORIGIN=http://127.0.0.1:4310
NIMANTO_DATA_DIR=.nimanto-data
NIMANTO_DEMO_MODE=on
# Optional exact installed Ollama tag. When set, packet approval fails closed if
# that model/digest is unavailable or its required structured review cannot run.
NIMANTO_ASSURANCE_MODEL=

# Optional exact-host HTTPS retrieval. Enabling it requires a recorded terms review date.
NIMANTO_URL_ALLOWLIST=
NIMANTO_URL_TERMS_REVIEWED_AT=

# Optional scheduled public-board refresh. Leave blank to keep the worker read-only.
NIMANTO_API_ORIGIN=http://127.0.0.1:4310
NIMANTO_SOURCE_PROVIDER=
NIMANTO_SOURCE_BOARD=

# Operator ceiling only. Even when on, each tenant starts not-ready after every
# API restart and must explicitly enable readiness in the workbench.
NIMANTO_EXTERNAL_ACTIONS_ENABLED=off

# GitHub Pages build only.
NIMANTO_GITHUB_PAGES=false
NEXT_PUBLIC_BASE_PATH=
